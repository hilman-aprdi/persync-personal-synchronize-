# Google Gemini API Key (Dapatkan di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini yang digunakan (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Secret key acak untuk menandatangani cookie kuota harian 3x per hari (Signed Cookie)
QUOTA_SECRET=your_long_random_secret_string_here
